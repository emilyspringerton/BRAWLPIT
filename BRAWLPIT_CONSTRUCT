// --- STAGE GEOMETRY (2.5D) ---
// X, Y, W, H, Type (0=Solid, 1=Passthrough)
typedef struct { float x, y, w, h; int type; } Platform;

static Platform stage_geo[] = {
    {0.0f, -5.0f, 60.0f, 10.0f, 0},   // Main Stage (FD)
    {-15.0f, 8.0f, 12.0f, 1.0f, 1},   // Left Plat
