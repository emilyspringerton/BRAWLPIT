+static inline void apply_friction(Vec3 *vel3, float friction_per_sec, float dt)
+{
+    Vec2 v2 = { vel3->x, vel3->y };
+    apply_friction_2d(&v2, friction_per_sec, dt);
+    vel3->x = v2.x;
+    vel3->y = v2.y;
