+/* BRAWLPIT: Camera State */
+Camera2D main_cam = { .x = 0.0f, .y = 0.0f, .zoom = 1.0f, .target_zoom = 1.0f };
+
+void update_camera(int num_players, PlayerState *players) {
+    float min_x = 9999.0f, max_x = -9999.0f;
+    float min_y = 9999.0f, max_y = -9999.0f;
+    int active = 0;
+
+    for(int i=0; i<MAX_CLIENTS; i++) {
+        if (players[i].active) {
+            if (players[i].x < min_x) min_x = players[i].x;
+            if (players[i].x > max_x) max_x = players[i].x;
+            if (players[i].y < min_y) min_y = players[i].y;
+            if (players[i].y > max_y) max_y = players[i].y;
+            active++;
+        }
+    }
+
+    if (active > 0) {
+        float target_x = (min_x + max_x) * 0.5f;
+        float target_y = (min_y + max_y) * 0.5f;
+        
+        main_cam.x += (target_x - main_cam.x) * 0.1f;
+        main_cam.y += (target_y - main_cam.y) * 0.1f;
+
+        float width = max_x - min_x;
+        float height = max_y - min_y;
+        float spread = (width > height) ? width : height;
+        
+        main_cam.target_zoom = 1.0f + (spread * 0.05f);
+        if (main_cam.target_zoom < 1.0f) main_cam.target_zoom = 1.0f;
+        if (main_cam.target_zoom > 3.0f) main_cam.target_zoom = 3.0f;
+        
+        main_cam.zoom += (main_cam.target_zoom - main_cam.zoom) * 0.05f;
+    }
+}
+
+void setup_2d_camera() {
+    glMatrixMode(GL_PROJECTION);
+    glLoadIdentity();
+    
+    float ar = 1280.0f / 720.0f;
+    float view_h = 20.0f * main_cam.zoom;
+    float view_w = view_h * ar;
+    
+    glOrtho(main_cam.x - view_w/2, main_cam.x + view_w/2,
+            main_cam.y - view_h/2, main_cam.y + view_h/2,
+            -100.0f, 100.0f);
+            
+    glMatrixMode(GL_MODELVIEW);
+    glLoadIdentity();
+}
